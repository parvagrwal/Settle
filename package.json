{
  "name": "settle",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "node --experimental-strip-types src/server/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:app": "npm --prefix app test",
    "test:e2e": "playwright test",
    "typecheck": "npm --prefix app exec -- tsc -p tsconfig.server.json",
    "verify": "npm run typecheck && npm test && npm --prefix app test && npm --prefix app run build && npm run test:e2e",
    "inspect:db": "node --experimental-strip-types scripts/inspect-product-db.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "fast-check": "^4.10.2"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "1.11.0"
  }
}
