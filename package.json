{
  "name": "settle",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "node --experimental-strip-types src/server/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:app": "npm --prefix app test",
    "test:e2e": "playwright test",
    "typecheck": "npm --prefix app exec -- tsc -p tsconfig.server.json",
    "verify": "npm run typecheck && npm test && npm --prefix app test && npm --prefix app run build && npm run test:e2e && npm run inventory:check",
    "inspect:db": "node --experimental-strip-types scripts/inspect-product-db.ts",
    "inventory:frontend": "node scripts/frontend-inventory.mjs",
    "inventory:check": "node scripts/frontend-inventory.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.1.0",
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "fast-check": "^4.10.2"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "1.11.0"
  }
}
