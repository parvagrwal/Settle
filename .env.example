# Variable NAMES only. No values, no secrets, ever.
# Copy to .env and fill in locally. Never paste secrets in a message. Never commit .env.
# PayPal sandbox app: developer.paypal.com, Dashboard, My Apps & Credentials, Sandbox tab, Create App.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Receiver email: a sandbox Personal account email. Dashboard, Sandbox, Accounts.
PAYPAL_SANDBOX_RECEIVER_EMAIL=
# Email of the client being billed. Sandbox only, any sandbox email works for the test.
PAYPAL_SANDBOX_CLIENT_EMAIL=
# Groq API key for the model proposer. Create it at console.groq.com yourself. Free tier, no card.
# Without it, the built-in proposer takes over and says so on screen.
GROQ_API_KEY=
# Owner token for the approve, pay, and allocation-write APIs. Choose a long
# random value and put it here only. The dashboard asks for it once per
# session and keeps it in that browser tab only. Without it, those routes
# refuse with 503; a wrong token is 401. Never commit it, never paste it.
SETTLE_OWNER_TOKEN=
# Optional REAL owner metadata shown after server verification. No identity is
# accepted from the browser. Leave blank for the neutral "Workspace owner".
SETTLE_OWNER_NAME=
SETTLE_OWNER_EMAIL=
# PayPal webhook subscription ID. Required to accept verified transaction events.
PAYPAL_WEBHOOK_ID=
# Local SQLite file. No external database service is required.
SETTLE_DB_PATH=data/settle.db
PORT=3000
# Durable confirmation backoff. Optional; the defaults are 2000 ms base,
# x2 growth, 60000 ms ceiling, 12 attempts, 20% jitter. Invalid values fall
# back to the defaults rather than failing startup.
SETTLE_CONFIRM_BASE_MS=
SETTLE_CONFIRM_MAX_MS=
SETTLE_CONFIRM_MAX_ATTEMPTS=
SETTLE_CONFIRM_JITTER=
# How often the server sweeps payments whose confirmation work is due.
SETTLE_CONFIRM_INTERVAL_MS=30000
